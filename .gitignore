# --- Raw and derived data: never versioned ---------------------------------
# Source CSVs from the TCE-ES portal (~13 GB) and every layer output stay out
# of git. See README "Data is not in this repository" for how to obtain them.
/data/
*.zip
*.csv
*.parquet
*.orc
_delta_log/

# The committed sample is the one exception: it is what makes the repo
# runnable without downloading 13 GB.
!/sample/*.csv
!/sample/**/*.csv

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

